<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CA1707: test method names follow the documented Method_Scenario_Expected pattern (underscores intentional).
         CA1711: xUnit's [CollectionDefinition] convention requires a type name ending in "Collection".
         CA1716: the "Shared" namespace segment (a VB keyword) mirrors the library under test; C#-only toolset.
         xUnit1051: integration tests do not need TestContext.Current.CancellationToken plumbing.
         All suppressions are scoped to the test project only and do not relax src-side analyzer enforcement. -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1716;xUnit1051</NoWarn>
    <PackageId>RaccoonNinja.McpToolset.Common.SkillStats.Tests</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RaccoonNinja.McpToolset.Common.SkillStats\RaccoonNinja.McpToolset.Common.SkillStats.csproj" />
  </ItemGroup>

</Project>