<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RaccoonNinja.McpToolset.Shared.SkillStats</RootNamespace>
    <AssemblyName>RaccoonNinja.McpToolset.Shared.SkillStats</AssemblyName>
    <Description>Skill-usage storage core shared by the skill-usage ingest CLI and the skill-stats MCP server: config, SQLite schema and migrations, connection factory, repository, and skill-name normalization. Holds no MCP-protocol or hosting knowledge, so both binaries share one byte-identical store.</Description>
    <!-- CA1716: the "Shared" namespace segment states this library's role (storage core shared by
         the two skill-stats binaries) and is a deliberate, chosen name. It collides with a VB
         keyword, which does not apply to this C#-only toolset. Scoped to this project only. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Storage\Schema\0001_init.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both binaries' test projects exercise internal helpers through the shared library. -->
    <InternalsVisibleTo Include="RaccoonNinja.McpToolset.Shared.SkillStats.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Direct reference so the central 3.0.5 pin overrides the vulnerable transitive 2.1.11
         (GHSA-2m69-gcr7-jv3q); Microsoft.Data.Sqlite declares an open >= range, so this is legal. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>