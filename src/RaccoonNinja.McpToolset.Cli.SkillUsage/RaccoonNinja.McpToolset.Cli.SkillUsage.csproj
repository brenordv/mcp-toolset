<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RaccoonNinja.McpToolset.Cli.SkillUsage</RootNamespace>
    <AssemblyName>skill-usage</AssemblyName>
    <Description>Claude Code PostToolUse hook binary: reads the Skill tool's hook JSON from stdin and appends one row to the local skill-usage SQLite store. Never blocks the agent; failures go to a log file and stderr.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project drives the internal ingest pipeline in-process against injected streams. -->
    <InternalsVisibleTo Include="RaccoonNinja.McpToolset.Cli.SkillUsage.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaccoonNinja.McpToolset.Common.SkillStats\RaccoonNinja.McpToolset.Common.SkillStats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="..\..\eng\ServerPublish.props" />

</Project>