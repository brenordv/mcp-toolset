<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RaccoonNinja.McpToolset.Server.SkillStats</RootNamespace>
    <AssemblyName>skill-stats-mcp</AssemblyName>
    <Description>Local stdio MCP server: read-only skill-usage statistics over the local skill-usage SQLite store. Answers which skills are used most, recent invocations of one skill, and totals plus ingestion health.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1707: MCP tool input schemas take their property names verbatim from C# method
         parameter names, and the wire contract uses snake_case (days_back, skill, limit).
         Scoped to this project only. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project unit-tests internal tool helpers (store gate, cutoff/limit validation). -->
    <InternalsVisibleTo Include="RaccoonNinja.McpToolset.Server.SkillStats.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaccoonNinja.McpToolset.Common.SkillStats\RaccoonNinja.McpToolset.Common.SkillStats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <Import Project="..\..\eng\ServerPublish.props" />

</Project>